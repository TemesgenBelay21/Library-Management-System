# AuraLib environment template.
# Copy this file to ".env" and adjust the values for your machine.
# The real ".env" is ignored by git and must never be committed.

# "local" or "production". Keep "production" on a live server.
APP_ENV=local

# Show detailed errors on screen. Always false in production.
APP_DEBUG=true

# Base URL of the application, with no trailing slash.
# XAMPP (project inside htdocs):
APP_URL=http://localhost/Library-Management-System/public
# Virtual host or document-root pointed straight at public/:
# APP_URL=http://auralib.test

# MySQL connection used by config/database.php.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auralib
DB_USERNAME=root
DB_PASSWORD=
